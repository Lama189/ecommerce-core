{
  "info": {
    "name": "User Service",
    "description": "Postman-коллекция для тестирования сервиса пользователей soundwave-platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Регистрация (Register)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+998901234567\",\n  \"password\": \"SecretPass123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "register"]
        },
        "description": "Регистрация нового пользователя. Важно: телефон формата Узбекистана (+998XXXXXXXXX, 13 символов)."
      }
    },
    {
      "name": "2. Вход (Login) - автосохранение токена",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var data = pm.response.json();",
              "    pm.collectionVariables.set(\"access_token\", data.access_token);",
              "    console.log(\"Access token saved:\", data.access_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+998901234567\",\n  \"password\": \"SecretPass123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "login"]
        },
        "description": "Вход пользователя. При успехе access_token автоматически запишется в переменную коллекции."
      }
    },
    {
      "name": "3. Текущий пользователь (Get Me)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/users/me",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users", "me"]
        },
        "description": "Получение данных авторизованного пользователя. Токен подставляется автоматически из переменной access_token."
      }
    },
    {
      "name": "4. Негативный тест: Повторная регистрация (409 Conflict)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+998901234567\",\n  \"password\": \"SecretPass123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "register"]
        },
        "description": "Проверка уникальности телефона. Должна вернуться ошибка 409 Conflict."
      }
    },
    {
      "name": "5. Негативный тест: Неверный пароль (401 Unauthorized)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+998901234567\",\n  \"password\": \"WrongPassword\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "login"]
        },
        "description": "Попытка входа с неверным паролем. Должен вернуть 401 Unauthorized."
      }
    }
  ]
}
